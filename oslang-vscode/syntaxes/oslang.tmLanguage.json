{
  "scopeName": "source.oslang",
  "name": "OSLANG 0.61",
  "fileTypes": [".osl", ".oslang"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.oslang",
          "match": "'[^\\n]*$"
        },
        {
          "name": "comment.line.rem.oslang",
          "match": "\\bREM\\b[^\\n]*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oslang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.oslang",
              "match": "\\\\."
            },
            {
              "name": "string.interpolation.oslang",
              "begin": "\\${",
              "end": "}",
              "patterns": [
                {
                  "include": "#keywords"
                },
                {
                  "include": "#types"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#operators"
                },
                {
                  "include": "#builtin-functions"
                },
                {
                  "include": "#identifiers"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.number.oslang",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.oslang",
          "match": "(?i)\\b(AND|BREAK|CONTINUE|DO|ELIF|ELSE|END|FOR|IF|NOT|OR|RETURN|STEP|THEN|TO|WHILE|TRY|CATCH|SWITCH|CASE|DEFAULT|ON|RAISE)\\b"
        },
        {
          "name": "keyword.declaration.oslang",
          "match": "(?i)\\b(CONSTRUCTOR|FUNCTION|CLASS|INTERFACE|VAR|GLOBAL|USING|EVENT|ENUM)\\b"
        },
        {
          "name": "keyword.other.oslang",
          "match": "(?i)\\b(BASE|ME|NEW|PRINT|INPUT|CLEAR|CLS|VIRTUAL|OVERRIDE|KISS|TYPE|MATH|FILE|DIR|DATE|TIME|SHOW|MOD|TYPEOF|SQRT|POW|FLOOR|CEIL|COUNT|STR|BOOL)\\b"
        },
        {
          "name": "storage.modifier.oslang",
          "match": "(?i)\\b(PUBLIC|PRIVATE|PROTECTED|STATIC)\\b"
        },
        {
          "name": "constant.language.oslang",
          "match": "(?i)\\b(TRUE|FALSE|NULL)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.oslang",
          "match": "(?i)\\b(NUMBER|STRING|BOOLEAN|ARRAY|NULL|OBJECT|DATE|TIME)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.oslang",
          "match": "\\*\\*|\\+\\+|--|\\+=|=>|%|\\*|\\/"
        },
        {
          "name": "keyword.operator.comparison.oslang",
          "match": "=|<>|<|>|<=|>="
        },
        {
          "name": "keyword.operator.logical.oslang",
          "match": "\\bAND\\b|\\bOR\\b|\\bNOT\\b|\\bMOD\\b"
        },
        {
          "name": "keyword.operator.arrow.oslang",
          "match": "=>"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.oslang",
          "match": "(?i)\\b(SQRT|POW|FLOOR|CEIL|STR|NUMBER|BOOL|COUNT|TYPEOF|ABS|LENGTH|TOUPPER|TOLOWER|TRIM|SUBSTR|CONTAINS|REVERSE|NORMALIZE|SORT|JOIN|FIRST|LAST|INDEXOF|REMOVE|FLAT|PUSH|POP|FINDINDEX|REPEAT|PADSTART|PADEND|TRUNC|SIN|COS|TAN|PI|RANDOM|NOW|FORMAT)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.oslang",
          "match": "\\b[A-Z_][A-Z0-9_]*\\b"
        }
      ]
    }
  }
}
