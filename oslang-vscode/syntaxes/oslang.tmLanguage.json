{
  "scopeName": "source.oslang",
  "name": "OSLANG 0.2",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.oslang",
          "match": "'[^\\n]*$"
        },
        {
          "name": "comment.line.rem.oslang",
          "match": "\\bREM\\b[^\\n]*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oslang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.oslang",
              "match": "\\\\.?"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.number.oslang",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.oslang",
          "match": "\\b(AND|BREAK|CONTINUE|DO|ELIF|ELSE|END|FOR|IF|NOT|OR|RETURN|STEP|THEN|TO|WHILE|TRY|CATCH)\\b"
        },
        {
          "name": "keyword.declaration.oslang",
          "match": "\\b(CONSTRUCTOR|FUNCTION|CLASS|INTERFACE|VAR|GLOBAL)\\b"
        },
        {
          "name": "keyword.other.oslang",
          "match": "\\b(BASE|ME|NEW|PRINT|INPUT|CLEAR|CLS)\\b"
        },
        {
          "name": "storage.modifier.oslang",
          "match": "\\b(PUBLIC|PRIVATE|PROTECTED)\\b"
        },
        {
          "name": "constant.language.oslang",
          "match": "\\b(TRUE|FALSE|NULL)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.oslang",
          "match": "\\b(NUMBER|STRING|BOOLEAN|ARRAY|VOID)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.oslang",
          "match": "\\b[A-Z_][A-Z0-9_]*\\b"
        }
      ]
    }
  }
}
