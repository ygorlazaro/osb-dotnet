{
  "scopeName": "source.oslang",
  "name": "OSLANG 0.3",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.oslang",
          "match": "'[^\\n]*$"
        },
        {
          "name": "comment.line.rem.oslang",
          "match": "\\bREM\\b[^\\n]*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oslang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.oslang",
              "match": "\\\\.?"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.number.oslang",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
      "keywords": {
        "patterns": [
          {
            "name": "keyword.control.oslang",
            "match": "(?i)\\b(AND|BREAK|CONTINUE|DO|ELIF|ELSE|END|FOR|IF|NOT|OR|RETURN|STEP|THEN|TO|WHILE|TRY|CATCH|SWITCH|CASE|DEFAULT|ON|RAISE)\\b"
          },
          {
            "name": "keyword.declaration.oslang",
            "match": "(?i)\\b(CONSTRUCTOR|FUNCTION|CLASS|INTERFACE|VAR|GLOBAL|USING|EVENT)\\b"
          },
          {
            "name": "keyword.other.oslang",
            "match": "(?i)\\b(BASE|ME|NEW|PRINT|INPUT|CLEAR|CLS|VIRTUAL|OVERRIDE|KISS|TYPE|MATH|FILE|DIR|DATE|TIME)\\b"
          },
          {
            "name": "storage.modifier.oslang",
            "match": "(?i)\\b(PUBLIC|PRIVATE|PROTECTED|STATIC)\\b"
          },
          {
            "name": "constant.language.oslang",
            "match": "(?i)\\b(TRUE|FALSE|NULL)\\b"
          }
        ]
      },
    "types": {
      "patterns": [
        {
          "name": "storage.type.oslang",
          "match": "(?i)\\b(NUMBER|STRING|BOOLEAN|ARRAY|NULL|OBJECT|DATE|TIME)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.oslang",
          "match": "\\b[A-Z_][A-Z0-9_]*\\b"
        }
      ]
    }
  }
}
