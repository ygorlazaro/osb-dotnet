{
  "Function Declaration": {
    "prefix": "function",
    "body": [
      "FUNCTION ${1:Name}(${2:parameters})",
      "    $0",
      "END FUNCTION"
    ],
    "description": "Create a new function"
  },
  "Class Declaration": {
    "prefix": "class",
    "body": [
      "CLASS ${1:ClassName}",
      "    $0",
      "END"
    ],
    "description": "Create a new class"
  },
  "Interface Declaration": {
    "prefix": "interface",
    "body": [
      "INTERFACE ${1:IName}",
      "    $0",
      "END"
    ],
    "description": "Create an interface"
  },
  "Constructor": {
    "prefix": "constructor",
    "body": [
      "CONSTRUCTOR(${1:parameters})",
      "    $0",
      "END"
    ],
    "description": "Create a constructor"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "IF ${1:condition} THEN",
      "    $0",
      "END"
    ],
    "description": "Create an if statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "IF ${1:condition} THEN",
      "    $2",
      "ELSE",
      "    $0",
      "END"
    ],
    "description": "Create an if-else statement"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "FOR ${1:I} = ${2:1} TO ${3:10}",
      "    $0",
      "END"
    ],
    "description": "Create a for loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "WHILE ${1:condition}",
      "    $0",
      "END"
    ],
    "description": "Create a while loop"
  },
  "Try-Catch": {
    "prefix": "try",
    "body": [
      "TRY",
      "    $1",
      "CATCH ${2:ERR}",
      "    PRINT \"Erro: \" + $2",
      "END"
    ],
    "description": "Create a try-catch block"
  },
  "Print Statement": {
    "prefix": "print",
    "body": [
      "PRINT ${1:\"Hello World\"}"
    ],
    "description": "Create a print statement"
  },
  "Input Statement": {
    "prefix": "input",
    "body": [
      "INPUT ${1:Variable}"
    ],
    "description": "Create an input statement"
  },
  "Variable Declaration": {
    "prefix": "var",
    "body": [
      "VAR ${1:Name} ${2:NUMBER}"
    ],
    "description": "Declare a variable"
  },
  "Property Declaration": {
    "prefix": "prop",
    "body": [
      "${1:PUBLIC} VAR ${2:Name} ${3:NUMBER}"
    ],
    "description": "Declare a class property"
  },
  "Method Declaration": {
    "prefix": "method",
    "body": [
      "${1:PUBLIC} ${2:MethodName}(${3:parameters})",
      "    $0",
      "END"
    ],
    "description": "Declare a class method"
  },
  "ME Reference": {
    "prefix": "me",
    "body": [
      "ME.${1:Property}"
    ],
    "description": "Reference current object instance"
  },
  "New Object": {
    "prefix": "new",
    "body": [
      "${1:obj} = NEW ${2:ClassName}($3)"
    ],
    "description": "Create a new object instance"
  },
  "Base Constructor Call": {
    "prefix": "base",
    "body": [
      "BASE(${1:args})"
    ],
    "description": "Call base class constructor"
  },
  "Return Statement": {
    "prefix": "return",
    "body": [
      "RETURN ${1:value}"
    ],
    "description": "Return from function/method"
  },
  "USING Statement": {
    "prefix": "using",
    "body": [
      "USING ${1:ModuleName}"
    ],
    "description": "Import a module"
  },
  "SWITCH Statement": {
    "prefix": "switch",
    "body": [
      "SWITCH ${1:Value}",
      "    CASE ${2:1}",
      "        $0",
      "    END",
      "END"
    ],
    "description": "Create a switch statement"
  },
  "SWITCH Expression": {
    "prefix": "switchexpr",
    "body": [
      "Result = SWITCH ${1:Value}",
      "    CASE ${2:1} => ${3:\"One\"}",
      "    DEFAULT => ${4:\"Other\"}",
      "PRINT Result"
    ],
    "description": "Create a switch expression"
  },
  "EVENT Declaration": {
    "prefix": "event",
    "body": [
      "EVENT ${1:Clicked}"
    ],
    "description": "Declare an event"
  },
  "ON Handler": {
    "prefix": "on",
    "body": [
      "ON ${1:obj}.${2:EVENT}",
      "    $0",
      "END ON"
    ],
    "description": "Create an event handler"
  },
  "RAISE Event": {
    "prefix": "raise",
    "body": [
      "RAISE ${1:EVENT}(${2:args})"
    ],
    "description": "Raise an event"
  },
  "Virtual Method": {
    "prefix": "virtual",
    "body": [
      "VIRTUAL ${1:FUNCTION} ${2:MethodName}(${3:parameters})",
      "    $0",
      "END FUNCTION"
    ],
    "description": "Declare a virtual method"
  },
  "Override Method": {
    "prefix": "override",
    "body": [
      "OVERRIDE ${1:FUNCTION} ${2:MethodName}(${3:parameters})",
      "    $0",
      "END FUNCTION"
    ],
    "description": "Override an inherited method"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "ENUM ${1:Name}",
      "    ${2:MEMBER1}",
      "    ${3:MEMBER2} = ${4:1}",
      "END"
    ],
    "description": "Create an enum declaration"
  },
  "EnumSet": {
    "prefix": "enumset",
    "body": [
      "Set = ${1:EnumName}.${2:MEMBER1} | ${1:EnumName}.${3:MEMBER2}"
    ],
    "description": "Create an enum set"
  },
  "Arrow Function": {
    "prefix": "arrow",
    "body": [
      "${1:Name} = X => $2"
    ],
    "description": "Create an arrow function"
  },
  "Arrow Function Block": {
    "prefix": "arrowblock",
    "body": [
      "${1:Name} = X =>",
      "    $2",
      "    RETURN X",
      "END"
    ],
    "description": "Create an arrow function with block body"
  },
  "For Each Loop": {
    "prefix": "foreach",
    "body": [
      "FOR EACH ${1:Item} IN ${2:Array}",
      "    $0",
      "END"
    ],
    "description": "Create a for each loop"
  },
  "Foreach Method": {
    "prefix": "foreachmethod",
    "body": [
      "${1:Array}.FOREACH(${2:Item} =>",
      "    $3",
      "END)"
    ],
    "description": "Use FOREACH method on array"
  },
  "Do While Loop": {
    "prefix": "dowhile",
    "body": [
      "DO",
      "    $1",
      "WHILE ${2:condition}"
    ],
    "description": "Create a do-while loop"
  },
  "Elif": {
    "prefix": "elif",
    "body": [
      "ELIF ${1:condition} THEN",
      "    $0"
    ],
    "description": "Create an elif block"
  },
  "Comment": {
    "prefix": "rem",
    "body": [
      "' $0"
    ],
    "description": "Add a comment"
  },
  "String Interpolation": {
    "prefix": "interp",
    "body": [
      "\"${1:Hello} \${${2:Name}}\""
    ],
    "description": "Create a string interpolation"
  },
  "MATH Expression": {
    "prefix": "math",
    "body": [
      "MATH.${1:SQRT}($2)"
    ],
    "description": "Use a MATH function"
  },
  "I18N Get": {
    "prefix": "i18nget",
    "body": [
      "I18N.GET(\"${1:key}\")"
    ],
    "description": "Get an I18N translation"
  },
  "I18N Set Language": {
    "prefix": "i18nlang",
    "body": [
      "I18N.SETLANGUAGE(\"${1:EN-US}\")"
    ],
    "description": "Set the I18N language"
  },
  "FILE Read": {
    "prefix": "fileread",
    "body": [
      "FILE.READ(\"${1:path}\")"
    ],
    "description": "Read a file"
  },
  "DIR List": {
    "prefix": "dirlist",
    "body": [
      "DIR.LIST(\"${1:.}\")"
    ],
    "description": "List directory contents"
  },
  "DATE NOW": {
    "prefix": "datenow",
    "body": [
      "DATE.NOW()"
    ],
    "description": "Get current date and time"
  },
  "TRY CATCH with RAISE": {
    "prefix": "tryraise",
    "body": [
      "TRY",
      "    $1",
      "CATCH ${2:err}",
      "    PRINT \"Caught: \" + $2",
      "END"
    ],
    "description": "Create a try-catch block with error printing"
  },
  "IMPORT Module": {
    "prefix": "import",
    "body": [
      "USING ${1:ModuleName}"
    ],
    "description": "Import a module"
  },
  "GLOBAL Variable": {
    "prefix": "global",
    "body": [
      "GLOBAL ${1:Name} = ${2:value}"
    ],
    "description": "Declare a global variable"
  },
  "Array Literal": {
    "prefix": "arr",
    "body": [
      "[${1:1}, ${2:2}, ${3:3}]"
    ],
    "description": "Create an array literal"
  },
  "Array Foreach": {
    "prefix": "arrforeach",
    "body": [
      "${1:Array}.FOREACH(${2:Item} =>",
      "    $3",
      "END)"
    ],
    "description": "Iterate over array with FOREACH"
  }
}
}
