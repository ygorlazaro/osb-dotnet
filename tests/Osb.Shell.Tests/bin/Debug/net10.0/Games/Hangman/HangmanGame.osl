' OSLANG 0.51 - Hangman Game Module
CLASS HANGMANGAME
    VAR Words
    VAR Word
    VAR Guessed
    VAR Errors
    VAR MaxErrors
    VAR Stages

    CONSTRUCTOR()
        ME.Words = FILE.READ("../../CONF/HANGMAN.WDS")
        ME.MaxErrors = 7
        ME.Guessed = ""
        ME.Errors = 0
        ME.Stages = [
            ["", "", "", "", "", "========="],
            ["  |", "  |", "  |", "  |", "  |", "========="],
            ["  +---+", "  |", "  |", "  |", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |", "  |", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |   O", "  |", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |   O", "  |   |", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |   O", "  |  /|\\", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |   O", "  |  /|\\", "  |  / \\", "  |", "========="]
        ]
    END CONSTRUCTOR

    PUBLIC FUNCTION PLAY()
        IF COUNT(ME.Words) = 0 THEN
            PRINT I18N("hangman.no_words")
            RETURN
        END

        Index = MATH.RANDOM(0, COUNT(ME.Words) - 1)
        ME.Word = ME.Words[Index]
        ME.Guessed = ""
        ME.Errors = 0

        PRINT ""
        PRINT I18N("hangman.title")
        PRINT I18N("hangman.instruction")
        PRINT ""

        WHILE ME.Errors < ME.MaxErrors
            CLEAR
            PRINT I18N("hangman.title")
            PRINT ""
            ME.DRAW_STAGE()
            PRINT ""
            ME.DRAW_WORD()
            PRINT ""
            PRINT I18N("hangman.errors", STR(ME.Errors), STR(ME.MaxErrors))
            PRINT I18N("hangman.guessed", ME.GET_GUESSED_STRING())

            Display = ME.GET_DISPLAY()
            IF ME.GET_HIDDEN_COUNT(Display) = 0 THEN
                PRINT ""
                PRINT I18N("hangman.won", ME.Word)
                RETURN
            END

            PRINT ""
            SHOW I18N("hangman.input_prompt")
            INPUT Guess
            IF Guess = "0" OR COUNT(Guess) = 0 THEN
                RETURN
            END

            Letter = Guess.TOUPPER()
            IF COUNT(Letter) <> 1 THEN
                CONTINUE
            END

            IF ME.HAS_GUESSED(Letter) THEN
                CONTINUE
            END

            ME.ADD_GUESSED(Letter)
            IF NOT ME.CONTAINS_LETTER(ME.Word.NORMALIZE(), Letter) THEN
                ME.Errors++
            END
        END

        CLEAR
        PRINT I18N("hangman.title")
        PRINT ""
        ME.DRAW_STAGE()
        PRINT ""
        PRINT I18N("hangman.lost", ME.Word)
    END FUNCTION

    PUBLIC FUNCTION DRAW_STAGE()
        Stage = ME.Stages[ME.Errors]
        FOR I = 0 TO COUNT(Stage) - 1
            PRINT Stage[I]
        END
    END FUNCTION

    PUBLIC FUNCTION DRAW_WORD()
        Display = ME.GET_DISPLAY()
        Result = ""
        FOR I = 0 TO COUNT(Display) - 1
            IF I > 0 THEN
                Result += " "
            END
            Result += Display.SUBSTR(I, 1)
        END
        PRINT Result
    END FUNCTION

    PUBLIC FUNCTION GET_DISPLAY()
        Result = ""
        WordLen = COUNT(ME.Word)
        FOR I = 0 TO WordLen - 1
            NormalizedChar = ME.Word.SUBSTR(I, 1).NORMALIZE()
            IF ME.HAS_GUESSED(NormalizedChar) THEN
                Result += ME.Word.SUBSTR(I, 1)
            ELSE
                Result += "_"
            END
        END
        RETURN Result
    END FUNCTION

    PUBLIC FUNCTION GET_HIDDEN_COUNT(Display)
        HiddenCount = 0
        FOR I = 0 TO COUNT(Display) - 1
            IF Display.SUBSTR(I, 1) = "_" THEN
                HiddenCount++
            END
        END
        RETURN HiddenCount
    END FUNCTION

    PUBLIC FUNCTION HAS_GUESSED(Letter)
        RETURN ME.Guessed.INDEXOF(Letter) >= 0
    END FUNCTION

    PUBLIC FUNCTION ADD_GUESSED(Letter)
        ME.Guessed += Letter
    END FUNCTION

    PUBLIC FUNCTION GET_GUESSED_STRING()
        IF COUNT(ME.Guessed) = 0 THEN
            RETURN ""
        END
        Letters = []
        FOR I = 0 TO COUNT(ME.Guessed) - 1
            Letters.ADD(ME.Guessed.SUBSTR(I, 1))
        END
        RETURN Letters.JOIN(", ")
    END FUNCTION

    PUBLIC FUNCTION CONTAINS_LETTER(Word, Letter)
        RETURN Word.INDEXOF(Letter) >= 0
    END FUNCTION
END CLASS
