<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Osb.Xwin</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Sem PackageReference nenhum de propósito: XWIN aqui é um app de modo texto puro,
       só com a Console API do .NET. Nada de GTK/X11/Wayland, nada de toolkit gráfico -
       exatamente como o VBDOS original não precisava de nada além do BIOS de vídeo. -->

</Project>
