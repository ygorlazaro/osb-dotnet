' OSLANG 0.51 - Calendar Command
CLASS CALENDARAPP

    PUBLIC FUNCTION RUN(Args)
        IF COUNT(Args) = 0 THEN
            ME.SHOWMONTH(ME.NOW_MONTH(), ME.NOW_YEAR())
            RETURN
        END

        IF COUNT(Args) = 1 THEN
            TRY
                Value = NUMBER(Args[0])
            CATCH ERR
                PRINT I18N("usage")
                RETURN
            END
            IF Value >= 1 AND Value <= 12 THEN
                ME.SHOWMONTH(Value, ME.NOW_YEAR())
            ELSE
                ME.SHOWYEAR(Value)
            END
            RETURN
        END

        IF COUNT(Args) >= 2 THEN
            Month = NUMBER(Args[0])
            Year = NUMBER(Args[1])
            ME.SHOWMONTH(Month, Year)
        END
    END FUNCTION

    PRIVATE FUNCTION NOW_YEAR()
        Now = NOW()
        RETURN Now[0]
    END FUNCTION

    PRIVATE FUNCTION NOW_MONTH()
        Now = NOW()
        RETURN Now[1]
    END FUNCTION

    PRIVATE FUNCTION NOW_DAY()
        Now = NOW()
        RETURN Now[2]
    END FUNCTION

    PRIVATE FUNCTION NOW_HOUR()
        Now = NOW()
        RETURN Now[3]
    END FUNCTION

    PRIVATE FUNCTION NOW_MINUTE()
        Now = NOW()
        RETURN Now[4]
    END FUNCTION

    PRIVATE FUNCTION NOW_SECOND()
        Now = NOW()
        RETURN Now[5]
    END FUNCTION

    PRIVATE FUNCTION SHOWYEAR(Year)
        FOR Month = 1 TO 12
            ME.SHOWMONTH(Month, Year)
        END
    END FUNCTION

    PRIVATE FUNCTION SHOWMONTH(Month, Year)
        PRINT ""
        PRINT "   " + ME.MONTHNAME(Month).TOUPPER() + " / " + STR(Year)
        PRINT I18N("weekdays")

        FirstDay = ME.GETFIRSTDAYOFWEEK(Month, Year)
        DaysInMonth = ME.GETDAYSINMONTH(Month, Year)
        TodayDay = ME.NOW_DAY()
        TodayMonth = ME.NOW_MONTH()
        TodayYear = ME.NOW_YEAR()

        Line = ""
        IF FirstDay > 0 THEN
            FOR I = 1 TO FirstDay
                Line += "    "
            END
        END

        FOR Day = 1 TO DaysInMonth
            IsToday = (Day = TodayDay AND Month = TodayMonth AND Year = TodayYear)
            IF IsToday THEN
                Line += "[" + STR(Day).PADSTART(2) + "]"
            ELSE
                Line += " " + STR(Day).PADSTART(2) + " "
            END

            IF (Day + FirstDay) MOD 7 = 0 THEN
                PRINT Line
                Line = ""
            END
        END

        IF COUNT(Line) > 0 THEN
            PRINT Line
        END
        PRINT ""

        IF Month = TodayMonth AND Year = TodayYear THEN
            TodayWeekdayIndex = (FirstDay + TodayDay - 1) MOD 7
            TodayWeekday = ME.GETWEEKDAYFULLNAME(TodayWeekdayIndex)
            Hour = STR(ME.NOW_HOUR()).PADSTART(2)
            Minute = STR(ME.NOW_MINUTE()).PADSTART(2)
            Second = STR(ME.NOW_SECOND()).PADSTART(2)
            PRINT I18N("today", TodayWeekday, STR(TodayDay).PADSTART(2), STR(TodayMonth).PADSTART(2), STR(TodayYear), Hour, Minute, Second)
        END
    END FUNCTION

    PRIVATE FUNCTION MONTHNAME(Month)
        RETURN I18N("calendar.month_" + STR(Month))
    END FUNCTION

    PRIVATE FUNCTION WEEKDAYNAME(Weekday)
        Keys = ["calendar.weekday_sunday", "calendar.weekday_monday", "calendar.weekday_tuesday", "calendar.weekday_wednesday", "calendar.weekday_thursday", "calendar.weekday_friday", "calendar.weekday_saturday"]
        RETURN I18N(Keys[Weekday])
    END FUNCTION

    PRIVATE FUNCTION GETWEEKDAYFULLNAME(Weekday)
        Keys = ["calendar.weekday_full_sunday", "calendar.weekday_full_monday", "calendar.weekday_full_tuesday", "calendar.weekday_full_wednesday", "calendar.weekday_full_thursday", "calendar.weekday_full_friday", "calendar.weekday_full_saturday"]
        RETURN I18N(Keys[Weekday])
    END FUNCTION

    PRIVATE FUNCTION GETDAYSINMONTH(Month, Year)
        IF Month = 2 THEN
            IF (Year MOD 400 = 0) OR ((Year MOD 4 = 0) AND (Year MOD 100 <> 0)) THEN
                RETURN 29
            END
            RETURN 28
        END
        IF Month = 4 OR Month = 6 OR Month = 9 OR Month = 11 THEN
            RETURN 30
        END
        RETURN 31
    END FUNCTION

    PRIVATE FUNCTION GETFIRSTDAYOFWEEK(Month, Year)
        M = Month
        Y = Year
        IF M <= 2 THEN
            M = M + 12
            Y = Y - 1
        END
        Q = 1
        K = Y MOD 100
        J = (Y / 100).FLOOR()
        H = (Q + ((13 * (M + 1)) / 5).FLOOR() + K + (K / 4).FLOOR() + (J / 4).FLOOR() + 5 * J) MOD 7
        IF H = 0 THEN
            RETURN 6
        END
        RETURN H - 1
    END FUNCTION

END CLASS

FUNCTION MAIN(Args)
    App = NEW CALENDARAPP()
    App.RUN(Args)
END FUNCTION
