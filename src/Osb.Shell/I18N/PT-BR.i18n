user.add=  USER ADD <nome> <senha>   → adiciona usuário
user.change=  USER CHANGE <nome> <senha>   → altera senha
user.delete=  USER DEL <nome>   → exclui usuário
user.list=  USER LIST   → lista usuários cadastrados

