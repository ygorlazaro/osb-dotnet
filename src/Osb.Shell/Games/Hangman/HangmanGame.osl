' OSLANG 0.4 - Hangman Game Module
' First internal OSLANG app for OSB

CLASS HANGMANGAME

    VAR Words
    VAR Word
    VAR Guessed
    VAR Errors
    VAR MaxErrors
    VAR Stages

    CONSTRUCTOR()
        ME.Words = FILE.READ("../../CONF/HANGMAN.WDS")
        ME.MaxErrors = 7
        ME.Guessed = ""
        ME.Errors = 0
        ME.Stages = [
            ["", "", "", "", "", "========="],
            ["  |", "  |", "  |", "  |", "  |", "========="],
            ["  +---+", "  |", "  |", "  |", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |", "  |", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |   O", "  |", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |   O", "  |   |", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |   O", "  |  /|\\", "  |", "  |", "========="],
            ["  +---+", "  |   |", "  |   O", "  |  /|\\", "  |  / \\", "  |", "========="]
        ]
    END CONSTRUCTOR

    PUBLIC FUNCTION PLAY()
        IF COUNT(ME.Words) = 0 THEN
            PRINT "Nenhuma palavra disponivel para o jogo HANGMAN."
            RETURN
        END

        Index = MATH.RANDOM(0, COUNT(ME.Words) - 1)
        ME.Word = ME.Words[Index]
        ME.Guessed = ""
        ME.Errors = 0

        PRINT ""
        PRINT "*** JOGO DA FORCA ***"
        PRINT "Tente adivinhar a palavra letra por letra."
        PRINT ""

        WHILE ME.Errors < ME.MaxErrors
            CLEAR
            PRINT "*** JOGO DA FORCA ***"
            PRINT ""
            ME.DRAW_STAGE()
            PRINT ""
            ME.DRAW_WORD()
            PRINT ""
            PRINT "Erros: " + STR(ME.Errors) + "/" + STR(ME.MaxErrors)
            PRINT "Letras ja tentadas: " + ME.GET_GUESSED_STRING()

            Display = ME.GET_DISPLAY()
            IF ME.GET_HIDDEN_COUNT(Display) = 0 THEN
                PRINT ""
                PRINT "Voce ganhou! A palavra era: " + ME.Word
                RETURN
            END

            PRINT ""
            PRINT "Digite uma letra (ou 0 para sair): "
            INPUT Guess
            IF Guess = "0" OR COUNT(Guess) = 0 THEN
                RETURN
            END

            Letter = Guess.TOUPPER()
            IF COUNT(Letter) <> 1 THEN
                CONTINUE
            END

            IF ME.HAS_GUESSED(Letter) THEN
                CONTINUE
            END

            ME.ADD_GUESSED(Letter)
            IF ME.CONTAINS_LETTER(ME.Word.NORMALIZE(), Letter) = FALSE THEN
                ME.Errors = ME.Errors + 1
            END
        END

        CLEAR
        PRINT "*** JOGO DA FORCA ***"
        PRINT ""
        ME.DRAW_STAGE()
        PRINT ""
        PRINT "Voce perdeu! A palavra era: " + ME.Word
    END FUNCTION

    PUBLIC FUNCTION DRAW_STAGE()
        Stage = ME.Stages[ME.Errors]
        FOR I = 0 TO COUNT(Stage) - 1
            PRINT Stage[I]
        END
    END FUNCTION

    PUBLIC FUNCTION DRAW_WORD()
        Display = ME.GET_DISPLAY()
        Result = ""
        FOR I = 0 TO COUNT(Display) - 1
            IF I > 0 THEN
                Result = Result + " "
            END
            Result = Result + Display.SUBSTR(I, 1)
        END
        PRINT Result
    END FUNCTION

    PUBLIC FUNCTION GET_DISPLAY()
        Result = ""
        WordLen = COUNT(ME.Word)
        FOR I = 0 TO WordLen - 1
            NormalizedChar = ME.Word.SUBSTR(I, 1).NORMALIZE()
            IF ME.HAS_GUESSED(NormalizedChar) THEN
                Result = Result + ME.Word.SUBSTR(I, 1)
            ELSE
                Result = Result + "_"
            END
        END
        RETURN Result
    END FUNCTION

    PUBLIC FUNCTION GET_HIDDEN_COUNT(Display)
        HiddenCount = 0
        FOR I = 0 TO COUNT(Display) - 1
            IF Display.SUBSTR(I, 1) = "_" THEN
                HiddenCount = HiddenCount + 1
            END
        END
        RETURN HiddenCount
    END FUNCTION

    PUBLIC FUNCTION HAS_GUESSED(Letter)
        FOR I = 0 TO COUNT(ME.Guessed) - 1
            IF ME.Guessed.SUBSTR(I, 1) = Letter THEN
                RETURN TRUE
            END
        END
        RETURN FALSE
    END FUNCTION

    PUBLIC FUNCTION ADD_GUESSED(Letter)
        ME.Guessed = ME.Guessed + Letter
    END FUNCTION

    PUBLIC FUNCTION GET_GUESSED_STRING()
        IF COUNT(ME.Guessed) = 0 THEN
            RETURN ""
        END
        Result = ME.Guessed.SUBSTR(0, 1)
        FOR I = 1 TO COUNT(ME.Guessed) - 1
            Result = Result + ", " + ME.Guessed.SUBSTR(I, 1)
        END
        RETURN Result
    END FUNCTION

    PUBLIC FUNCTION CONTAINS_LETTER(Word, Letter)
        FOR I = 0 TO COUNT(Word) - 1
            IF Word.SUBSTR(I, 1) = Letter THEN
                RETURN TRUE
            END
        END
        RETURN FALSE
    END FUNCTION

END CLASS
