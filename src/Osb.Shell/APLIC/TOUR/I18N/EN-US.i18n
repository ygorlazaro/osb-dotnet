# Tour App - English (US)
default_username=you
welcome=Welcome to OSB Tour, {0}!
learn=Let's learn how to use the system step by step.
step=Step {0}: {1}
end==== End of Tour ===
finished=Now you know the basics of using OSB!
explore=Type HELP to explore more commands.
continue=-----Press ENTER to continue----
what_is_osb=What is OSB
what_is_osb_1=OSB is a text-based operating system with a command-line interface.
what_is_osb_2=You interact with it by typing commands and seeing the result on screen.
what_is_osb_3=All commands are case-insensitive: DIR, dir and Dir all work the same.
folders=Folder navigation
folders_1=Use CD to change folders and DIR to list files.
folders_examples=Examples:
folders_ex_1=  DIR               → lists files in current folder
folders_ex_2=  DIR /W            → lists in columns
folders_ex_3=  CD TEMP           → enters TEMP folder
folders_ex_4=  CD ..             → goes back to parent folder
folders_ex_5=  PWD               → shows current folder
files=Files and folders
files_1=Use MD to create folders and COPY to copy files.
files_examples=Examples:
files_ex_1=  MD MEUDIR         → creates a folder named MEUDIR
files_ex_2=  MD /P A\B\C      → creates parent folders automatically
files_ex_3=  COPY A.TXT B.TXT  → copies A.TXT to B.TXT
files_ex_4=  DEL ARQ.TXT       → deletes a file
files_ex_5=  REN OLD.TXT NEW.TXT → renames
view_files=Viewing file contents
view_files_1=Use TYPE to display text files on screen.
view_files_examples=Examples:
view_files_ex_1=  TYPE ARQ.TXT      → displays file contents
view_files_ex_2=  TYPE /N ARQ.TXT   → displays with line numbers
view_files_ex_3=  TYPE /P ARQ.TXT   → displays with pause every 20 lines
view_files_ex_4=  FIND text        → searches text within files
variables=Variables
variables_1=Use SET to create variables that can be used in commands.
variables_examples=Examples:
variables_ex_1=  SET NAME=Ygor     → defines NAME variable
variables_ex_2=  SET NAME          → shows variable value
variables_ex_3=  SET NAME=         → removes variable
variables_ex_4=  SET               → lists all variables
variables_ex_5=Variables are automatically expanded using %NAME%.
calculator=Quick calculator
calculator_1=Use PRINT to evaluate math expressions.
calculator_examples=Examples:
calculator_ex_1=  PRINT 2+2         → displays 4
calculator_ex_2=  PRINT 10*5+3      → displays 53
calculator_ex_3=  PRINT (2+2)*3     → displays 12
calculator_ops=Supported operators: +, -, *, / and parentheses.
new_in_051=New in OSLANG 0.51: MATH.SIN(), MATH.COS(), MATH.TAN(), MATH.PI, **, MOD, arrow functions.
pipes=Pipelines and filters
pipes_1=Use ; to chain commands (pipe) and GREP to filter lines.
pipes_examples=Examples:
pipes_ex_1=  DIR ; GREP git    → lists only items containing 'git'
pipes_ex_2=  HISTORY ; GREP CD → filters history by CD commands
pipes_ex_3=  TYPE ARQ.TXT ; GREP error → shows lines with 'error'
apps_help=Apps and help
apps_help_1=Use APLIC to view and run installed apps.
apps_help_2=Use HELP to see all commands.
apps_help_3=Use HELP <command> or <command> /? for specific help.
apps_examples=Examples:
apps_ex_1=  APLIC             → lists apps
apps_ex_2=  APLIC CAL         → opens calendar
apps_ex_3=  APLIC TOUR        → shows this tour
apps_ex_4=  HELP DIR          → DIR command help
apps_ex_5=  DIR /?            → same thing
apps_new=What's new:
apps_new_1=  OSL <file.osl> → runs OSLANG 0.51 programs
apps_new_2=  KISS <file>    → text editor with syntax highlight
apps_new_3=  GAMES          → installed games (ex: HANGMAN)
