# Tour App - Portuguese (Brazil)
default_username=você
welcome=Bem-vindo ao Tour do OSB, {0}!
learn=Vamos aprender a usar o sistema passo a passo.
step=Passo {0}: {1}
end==== Fim do Tour ===
finished=Agora você já sabe o básico para usar o OSB!
explore=Use HELP para explorar mais comandos.
continue=-----Pressione ENTER para continuar----
what_is_osb=O que é o OSB
what_is_osb_1=O OSB é um sistema operacional em texto, com interface de linha de comando.
what_is_osb_2=Você interage com ele digitando comandos e vendo o resultado na tela.
what_is_osb_3=Todos os comandos são case-insensitive: DIR, dir e Dir funcionam igual.
folders=Navegação de pastas
folders_1=Use CD para mudar de pasta e DIR para listar arquivos.
folders_examples=Exemplos:
folders_ex_1=  DIR               → lista arquivos da pasta atual
folders_ex_2=  DIR /W            → lista em colunas
folders_ex_3=  CD TEMP           → entra na pasta TEMP
folders_ex_4=  CD ..             → volta para a pasta anterior
folders_ex_5=  PWD               → mostra a pasta atual
files=Arquivos e pastas
files_1=Use MD para criar pastas e COPY para copiar arquivos.
files_examples=Exemplos:
files_ex_1=  MD MEUDIR         → cria uma pasta chamada MEUDIR
files_ex_2=  MD /P A\B\C      → cria pastas pais automaticamente
files_ex_3=  COPY A.TXT B.TXT  → copia A.TXT para B.TXT
files_ex_4=  DEL ARQ.TXT       → apaga um arquivo
files_ex_5=  REN ANTIGO.TXT NOVO.TXT → renomeia
view_files=Vendo o conteúdo de arquivos
view_files_1=Use TYPE para exibir arquivos de texto na tela.
view_files_examples=Exemplos:
view_files_ex_1=  TYPE ARQ.TXT      → exibe o conteúdo do arquivo
view_files_ex_2=  TYPE /N ARQ.TXT   → exibe com números de linha
view_files_ex_3=  TYPE /P ARQ.TXT   → exibe com pausa a cada 20 linhas
view_files_ex_4=  FIND texto        → busca texto dentro de arquivos
variables=Variáveis
variables_1=Use SET para criar variáveis que podem ser usadas em comandos.
variables_examples=Exemplos:
variables_ex_1=  SET NOME=Ygor     → define a variável NOME
variables_ex_2=  SET NOME          → mostra o valor da variável
variables_ex_3=  SET NOME=         → remove a variável
variables_ex_4=  SET               → lista todas as variáveis
variables_ex_5=Variáveis são expandidas automaticamente usando %NOME%.
calculator=Calculadora rápida
calculator_1=Use PRINT para avaliar expressões matemáticas.
calculator_examples=Exemplos:
calculator_ex_1=  PRINT 2+2         → exibe 4
calculator_ex_2=  PRINT 10*5+3      → exibe 53
calculator_ex_3=  PRINT (2+2)*3     → exibe 12
calculator_ops=Operadores suportados: +, -, *, / e parênteses.
new_in_051=Novo no OSLANG 0.6: MATH.SIN(), MATH.COS(), MATH.TAN(), MATH.PI, **, MOD, arrow functions.
pipes=Pipelines e filtros
pipes_1=Use ; para encadear comandos (pipe) e GREP para filtrar linhas.
pipes_examples=Exemplos:
pipes_ex_1=  DIR ; GREP git    → lista apenas itens que contém 'git'
pipes_ex_2=  HISTORY ; GREP CD → filtra o histórico por comandos com CD
pipes_ex_3=  TYPE ARQ.TXT ; GREP erro → mostra linhas com 'erro'
apps_help=Aplicativos e ajuda
apps_help_1=Use APLIC para ver e executar aplicativos instalados.
apps_help_2=Use HELP para ver a lista de todos os comandos.
apps_help_3=Use HELP <comando> ou <comando> /? para ver ajuda específica.
apps_examples=Exemplos:
apps_ex_1=  APLIC             → lista aplicativos
apps_ex_2=  APLIC CAL         → abre o calendário
apps_ex_3=  APLIC TOUR        → exibe este tour
apps_ex_4=  HELP DIR          → ajuda do comando DIR
apps_ex_5=  DIR /?            → mesma coisa
apps_new=Novidades:
apps_new_1=  OSL <arquivo.osl> → executa programas em OSLANG 0.6
apps_new_2=  KISS <arquivo>    → editor de texto com syntax highlight
apps_new_3=  GAMES             → jogos instalados (ex: HANGMAN)
