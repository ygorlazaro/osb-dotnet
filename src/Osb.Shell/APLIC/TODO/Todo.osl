' OSLANG 0.61 - TODO Implementation
USING OSL.I18N
CLASS TODOAPP

    PUBLIC FUNCTION RUN(Args)
        IF COUNT(Args) = 0 THEN
            ME.LIST(Args)
            RETURN
        END

        Command = Args[0].TOUPPER()
        IF Command = "ADD" THEN
            IF COUNT(Args) < 2 THEN
                PRINT I18N.GET("todo.usage_add")
                RETURN
            END
            TaskText = Args[1]
            FOR I = 2 TO COUNT(Args) - 1
                TaskText += " ${Args[I]}"
            END
            ME.ADD(TaskText)
        ELIF Command = "LIST" THEN
            ME.LIST(Args)
        ELIF Command = "DONE" THEN
            IF COUNT(Args) < 2 THEN
                PRINT I18N.GET("todo.usage_done")
                RETURN
            END
            Index = NUMBER(Args[1])
            ME.DONE(Index)
        ELIF Command = "CLEAR" THEN
            ME.CLEARALL()
        ELSE
            PRINT I18N("todo.unknown_command", Command)
            PRINT I18N.GET("todo.usage")
        END
    END FUNCTION

    PRIVATE FUNCTION ADD(TaskText)
        Tasks = ME.LOAD()
        Tasks.ADD(TaskText)
        ME.SAVE(Tasks)
        PRINT I18N.GET("todo.added")
    END FUNCTION

    PRIVATE FUNCTION LIST(Args)
        Tasks = ME.LOAD()
        ShowAll = FALSE
        IF COUNT(Args) >= 2 AND Args[1].TOUPPER() = "ALL" THEN
            ShowAll = TRUE
        END
        IF COUNT(Tasks) = 0 THEN
            PRINT I18N.GET("todo.no_tasks")
            RETURN
        END
        PRINT I18N.GET("todo.tasks")
        FOR I = 0 TO COUNT(Tasks) - 1
            Marker = ""
            IF Tasks[I].STARTSWITH("[x] ") THEN
                Marker = " [x]"
            ELSE
                Marker = " [ ]"
            END
            PRINT "${STR(I + 1)}${Marker} ${Tasks[I]}"
        END
    END FUNCTION

    PRIVATE FUNCTION DONE(Index)
        Tasks = ME.LOAD()
        IF Index < 1 OR Index > COUNT(Tasks) THEN
            PRINT I18N.GET("todo.invalid_index")
            RETURN
        END
        Task = Tasks[Index - 1]
        IF Task.STARTSWITH("[x] ") THEN
            PRINT I18N("todo.already_done", Task)
            RETURN
        END
        Tasks[Index - 1] = "[x] ${Task}"
        ME.SAVE(Tasks)
        PRINT I18N("todo.completed", Task)
    END FUNCTION

    PRIVATE FUNCTION CLEARALL()
        ME.SAVE([])
        PRINT I18N.GET("todo.cleared")
    END FUNCTION

    PRIVATE FUNCTION LOAD()
        Path = ME.FILE_PATH()
        IF FILE.EXISTS(Path) THEN
            Content = FILE.READTEXT(Path)
            IF COUNT(Content) = 0 THEN
                RETURN []
            END
            Lines = Content.SPLIT("\n")
            Result = []
            FOR I = 0 TO COUNT(Lines) - 1
                Line = Lines[I].TRIM()
                IF COUNT(Line) > 0 THEN
                    Result.ADD(Line)
                END
            END
            RETURN Result
        END
        RETURN []
    END FUNCTION

    PRIVATE FUNCTION SAVE(Tasks)
        Path = ME.FILE_PATH()
        Content = Tasks.JOIN("\n")
        IF COUNT(Content) > 0 THEN
            Content = Content + "\n"
        END
        FILE.WRITE(Path, Content)
    END FUNCTION

    PRIVATE FUNCTION FILE_PATH()
        RETURN "${DIR.CURRENT()}/.todo.txt"
    END FUNCTION

END CLASS
