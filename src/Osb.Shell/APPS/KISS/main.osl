USING OSL.CONSOLE
USING OSL.FILE
USING OSL.APP

CLASS KISS

    PRIVATE VAR Lines
    PRIVATE VAR Filename
    PRIVATE VAR Path
    PRIVATE VAR Row
    PRIVATE VAR Col
    PRIVATE VAR ScrollTop
    PRIVATE VAR Modified
    PRIVATE VAR Running
    PRIVATE VAR Status
    PRIVATE VAR Width
    PRIVATE VAR Height
    PRIVATE VAR VisibleRows
    PRIVATE VAR LineNumberWidth
    PRIVATE VAR TextWidth

    PUBLIC FUNCTION RUN(Args)
        Row = 0
        Col = 0
        ScrollTop = 0
        Modified = FALSE
        Running = TRUE
        Status = ""

        IF COUNT(Args) > 0 THEN
            Filename = Args[0]
            Path = Args[0]
            Load()
        ELSE
            Lines = [""]
            Filename = ""
            Path = ""
        END

        OSL.CONSOLE.ENTER()
        OSL.CONSOLE.ALTERNATE(TRUE)
        OSL.CONSOLE.HIDECURSOR()

        TRY
            Running = TRUE
            Render()
            WHILE Running
                Key = OSL.CONSOLE.GETKEY()
                HandleKey(Key)
                IF Running THEN
                    Render()
                END
            END
        CATCH ERR
            OSL.CONSOLE.SHOWCURSOR()
            OSL.CONSOLE.ALTERNATE(FALSE)
            OSL.CONSOLE.EXIT()
            PRINT ERR
            RETURN
        END

        OSL.CONSOLE.SHOWCURSOR()
        OSL.CONSOLE.ALTERNATE(FALSE)
        OSL.CONSOLE.EXIT()
    END

    PRIVATE FUNCTION LOAD()
        IF LEFT(Path, 1) <> "/" THEN
            FullPath = PWD() + "/" + Path
        ELSE
            FullPath = Path
        END
        IF OSL.FILE.EXISTS(FullPath) THEN
            Lines = OSL.FILE.READLINES(FullPath)
            IF COUNT(Lines) = 0 THEN
                Lines = [""]
            END
        ELSE
            Lines = [""]
        END
    END

    PRIVATE FUNCTION SAVE()
        IF Path = "" THEN
            OSL.CONSOLE.SHOWCURSOR()
            OSL.CONSOLE.SETCURSOR(Height, 1)
            SHOW "Save as: "
            INPUT TempFilename
            OSL.CONSOLE.HIDECURSOR()
            IF TempFilename = "" THEN
                Status = "Save cancelled"
                RETURN
            END
            Filename = TempFilename
            Path = TempFilename
        END

        IF LEFT(Path, 1) <> "/" THEN
            FullPath = PWD() + "/" + Path
        ELSE
            FullPath = Path
        END
        OSL.FILE.WRITELINES(FullPath, Lines)
        Modified = FALSE
        Status = "Saved"
    END

    PRIVATE FUNCTION RENDER()
        Size = OSL.CONSOLE.SIZE()
        Width = Size.WIDTH
        Height = Size.HEIGHT
        VisibleRows = Height - 2
        LineNumberWidth = MATH.MAX(4, COUNT(STR(COUNT(Lines))) + 1)
        TextWidth = Width - LineNumberWidth

        OSL.CONSOLE.BEGINFRAME()
        RenderContent()
        RenderStatus()
        OSL.CONSOLE.ENDFRAME()
    END

    PRIVATE FUNCTION RENDERCONTENT()
        IF Filename <> "" THEN
            Ext = RIGHT(Filename, 4)
            UseHighlight = (Ext = ".osl" OR RIGHT(Filename, 7) = ".oslang")
        ELSE
            UseHighlight = FALSE
        END
        FOR i = 0 TO VisibleRows - 1
            LineIndex = ScrollTop + i
            IF LineIndex < COUNT(Lines) THEN
                RawText = Lines[LineIndex]
                IF COUNT(RawText) > TextWidth THEN
                    Text = LEFT(RawText, TextWidth)
                ELSE
                    Text = RawText + REPEAT(" ", TextWidth - COUNT(RawText))
                END
            ELSE
                Text = REPEAT(" ", TextWidth)
            END

            IF LineIndex < COUNT(Lines) THEN
                LineNumber = STR(LineIndex + 1)
            ELSE
                LineNumber = "~"
            END
            OSL.CONSOLE.WRITE(i + 1, 1, LineNumber + " ")
            IF UseHighlight THEN
                OSL.CONSOLE.WRITE(i + 1, LineNumberWidth + 1, OSL.APP.HIGHLIGHT(Text, TextWidth))
            ELSE
                OSL.CONSOLE.WRITE(i + 1, LineNumberWidth + 1, Text)
            END
        END
    END

    PRIVATE FUNCTION RENDERSTATUS()
        Title = Filename
        IF Title = "" THEN
            Title = "(untitled)"
        END
        IF Modified THEN
            Title = Title + " [modified]"
        END
        Header = " KISS - " + Title + " "
        IF COUNT(Header) > Width THEN
            Header = LEFT(Header, Width)
        END
        OSL.CONSOLE.WRITE(Height - 1, 1, Header)

        Help = Status
        IF Help = "" THEN
            Help = "[ Ctrl+S / Save ]   [ ESC / Exit ]"
        END
        IF COUNT(Help) > Width THEN
            Help = LEFT(Help, Width)
        END
        OSL.CONSOLE.WRITE(Height, 1, Help)

        ScreenRow = Row - ScrollTop
        IF ScreenRow >= 0 AND ScreenRow < VisibleRows THEN
            ColPos = LineNumberWidth + MATH.MIN(Col, TextWidth - 1)
            OSL.CONSOLE.SETCURSOR(ScreenRow + 1, ColPos)
            OSL.CONSOLE.SHOWCURSOR()
        END
    END

    PRIVATE FUNCTION EnsureVisible()
        IF Row < ScrollTop THEN
            ScrollTop = Row
        ELSE IF Row >= ScrollTop + VisibleRows THEN
            ScrollTop = Row - VisibleRows + 1
        END
        IF ScrollTop < 0 THEN
            ScrollTop = 0
        END
        IF ScrollTop > COUNT(Lines) - VisibleRows THEN
            ScrollTop = MATH.MAX(0, COUNT(Lines) - VisibleRows)
        END
    END
    END

    PRIVATE FUNCTION HANDLEKEY(Key)
        SWITCH Key.KEY
            CASE KEY.ESC
                IF Modified THEN
                    IF NOT CONFIRMDISCARD() THEN
                        RETURN
                    END
                END
                Running = FALSE
                RETURN
            CASE KEY.UP
                IF Row > 0 THEN
                    Row = Row - 1
                    EnsureVisible()
                END
                Col = MATH.MIN(Col, COUNT(Lines[Row]))
                RETURN
            CASE KEY.DOWN
                IF Row < COUNT(Lines) - 1 THEN
                    Row = Row + 1
                    EnsureVisible()
                END
                Col = MATH.MIN(Col, COUNT(Lines[Row]))
                RETURN
            CASE KEY.LEFT
                IF Col > 0 THEN
                    Col = Col - 1
                ELIF Row > 0 THEN
                    Row = Row - 1
                    Col = COUNT(Lines[Row])
                    EnsureVisible()
                END
                RETURN
            CASE KEY.RIGHT
                IF Col < COUNT(Lines[Row]) THEN
                    Col = Col + 1
                ELIF Row < COUNT(Lines) - 1 THEN
                    Row = Row + 1
                    Col = 0
                    EnsureVisible()
                END
                RETURN
            CASE KEY.HOME
                Col = 0
                RETURN
            CASE KEY.END
                Col = COUNT(Lines[Row])
                RETURN
            CASE KEY.PAGEUP
                Row = MATH.MAX(0, Row - VisibleRows)
                ScrollTop = MATH.MAX(0, ScrollTop - VisibleRows)
                Col = MATH.MIN(Col, COUNT(Lines[Row]))
                RETURN
            CASE KEY.PAGEDOWN
                Row = MATH.MIN(COUNT(Lines) - 1, Row + VisibleRows)
                ScrollTop = MATH.MIN(COUNT(Lines) - VisibleRows, ScrollTop + VisibleRows)
                IF ScrollTop < 0 THEN
                    ScrollTop = 0
                END
                Col = MATH.MIN(Col, COUNT(Lines[Row]))
                RETURN
            CASE KEY.ENTER
                Line = Lines[Row]
                Lines = Lines.INSERTAT(Row + 1, RIGHT(Line, COUNT(Line) - Col))
                Lines[Row] = LEFT(Line, Col)
                Row = Row + 1
                Col = 0
                Modified = TRUE
                RETURN
            CASE KEY.BACKSPACE
                IF Col > 0 THEN
                    Lines[Row] = REMOVE(Lines[Row], Col - 1, 1)
                    Col = Col - 1
                    Modified = TRUE
                ELIF Row > 0 THEN
                    Col = COUNT(Lines[Row - 1])
                    Lines[Row - 1] = Lines[Row - 1] + Lines[Row]
                    Lines = Lines.REMOVEAT(Row)
                    Row = Row - 1
                    Modified = TRUE
                END
                RETURN
            CASE KEY.DELETE
                IF Col < COUNT(Lines[Row]) THEN
                    Lines[Row] = REMOVE(Lines[Row], Col, 1)
                    Modified = TRUE
                ELIF Row < COUNT(Lines) - 1 THEN
                    Lines[Row] = Lines[Row] + Lines[Row + 1]
                    Lines = Lines.REMOVEAT(Row + 1)
                    Modified = TRUE
                END
                RETURN
            CASE KEY.TAB
                Lines[Row] = INSERT(Lines[Row], Col, "    ")
                Col = Col + 4
                Modified = TRUE
                RETURN
            DEFAULT
                IF Key.CTRL AND Key.CHAR = "S" THEN
                    SAVE()
                    RETURN
                END
                IF Key.CTRL AND Key.CHAR = "Q" THEN
                    IF Modified THEN
                        IF NOT CONFIRMDISCARD() THEN
                            RETURN
                        END
                    END
                    Running = FALSE
                    RETURN
                END
                IF Key.CHAR <> NULL THEN
                    Lines[Row] = INSERT(Lines[Row], Col, Key.CHAR)
                    Col = Col + 1
                    Modified = TRUE
                    RETURN
                END
        END
    END

    PRIVATE FUNCTION CONFIRMDISCARD()
        OSL.CONSOLE.SHOWCURSOR()
        OSL.CONSOLE.SETCURSOR(Height, 1)
        SHOW "Unsaved changes. Discard? (Y/N): "
        INPUT Answer
        OSL.CONSOLE.HIDECURSOR()
        RETURN TOUPPER(Answer) = "Y"
    END

END

FUNCTION MAIN()
    App = NEW KISS()
    App.RUN(ARGS)
END
