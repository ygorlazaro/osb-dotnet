using System;
using OsbKT;

namespace Osb.Shell.Userspace
{
    internal static unsafe class Program
    {
        private static void Main()
        {
            const string welcome = "OSB Userspace Shell v0.1\r\n";
            const string okMsg = "Userspace execution OK.\r\n";
            const string prompt = "> ";
            const string exitMsg = "Exiting...\r\n";

            Syscall.PrintString(welcome);
            Syscall.PrintString(okMsg);

            // Stack-allocated buffers for input (max 255 chars)
            char* inputBuf = stackalloc char[256];

            bool shift = false;

            while (true)
            {
                Syscall.PrintString(prompt);

                int pos = 0;
                bool exitRequested = false;

                while (true)
                {
                    int sc = Syscall.GetKey();
                    if (sc == -1) continue; // No key

                    bool make = (sc & 0x80) == 0;
                    int key = sc & 0x7F;

                    if (!make)
                    {
                        // Break code: release shift keys
                        if (key == 0x2A || key == 0x36) // Left Shift or Right Shift
                            shift = false;
                        // Ignore other break codes
                        continue;
                    }

                    // Make code
                    if (key == 0x2A || key == 0x36) // Left Shift or Right Shift
                    {
                        shift = true;
                        continue;
                    }
                    if (key == 0x0E) // Backspace
                    {
                        if (pos > 0)
                        {
                            pos--;
                            Syscall.PrintString("\b \b"); // Erase last character
                        }
                        continue;
                    }
                    if (key == 0x1C) // Enter
                    {
                        Syscall.PrintString("\r\n");
                        break;
                    }

                    // Map scancode to character
                    char c = MapScancode((byte)key, shift);
                    if (c != 0)
                    {
                        if (pos < 255)
                        {
                            inputBuf[pos] = c;
                            pos++;
                            Syscall.PutChar(c); // Echo
                        }
                    }
                    // Ignore other keys (e.g., Ctrl, Alt, function keys)
                }

                // Null-terminate for safety
                inputBuf[pos] = '\0';

                // Check if the command is "exit" (case-insensitive)
                if (pos == 4 &&
                    ((inputBuf[0] | 0x20) == 'e') &&
                    ((inputBuf[1] | 0x20) == 'x') &&
                    ((inputBuf[2] | 0x20) == 'i') &&
                    ((inputBuf[3] | 0x20) == 't'))
                {
                    exitRequested = true;
                }

                if (exitRequested)
                {
                    Syscall.PrintString(exitMsg);
                    break;
                }

                // Not exiting: show that we got the command
                Syscall.PrintString("Command received: ");
                // Echo the input buffer character by character
                for (int i = 0; i < pos; i++)
                {
                    Syscall.PutChar(inputBuf[i]);
                }
                Syscall.PrintString("\r\n");
            }

            Syscall.Exit(0);
        }

        private static char MapScancode(byte sc, bool shift)
        {
            return sc switch
            {
                0x02 => shift ? '!' : '1',
                0x03 => shift ? '@' : '2',
                0x04 => shift ? '#' : '3',
                0x05 => shift ? '$' : '4',
                0x06 => shift ? '%' : '5',
                0x07 => shift ? '^' : '6',
                0x08 => shift ? '&' : '7',
                0x09 => shift ? '*' : '8',
                0x0A => shift ? '(' : '9',
                0x0B => shift ? ')' : '0',
                0x0C => shift ? '_' : '-',
                0x0D => shift ? '+' : '=',
                0x10 => 'Q',
                0x11 => 'W',
                0x12 => 'E',
                0x13 => 'R',
                0x14 => 'T',
                0x15 => 'Y',
                0x16 => 'U',
                0x17 => 'I',
                0x18 => 'O',
                0x19 => 'P',
                0x1A => shift ? '{' : '[',
                0x1B => shift ? '}' : ']',
                0x1E => 'A',
                0x1F => 'S',
                0x20 => 'D',
                0x21 => 'F',
                0x22 => 'G',
                0x23 => 'H',
                0x24 => 'J',
                0x25 => 'K',
                0x26 => 'L',
                0x27 => shift ? ':' : ';',
                0x28 => shift ? '"' : '\'',
                0x29 => shift ? '~' : '`',
                0x2B => shift ? '|' : '\\',
                0x2C => 'Z',
                0x2D => 'X',
                0x2E => 'C',
                0x2F => 'V',
                0x30 => 'B',
                0x31 => 'N',
                0x32 => 'M',
                0x33 => shift ? '<' : ',',
                0x34 => shift ? '>' : '.',
                0x35 => shift ? '?' : '/',
                0x39 => ' ',
                _ => (char)0
            };
        }
    }
}
